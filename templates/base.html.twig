<!DOCTYPE html>
<html lang="{{ app.request.locale|split('_')[0] }}">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% block meta %}
        {% include "@SuluWebsite/Extension/seo.html.twig" with {
            "seo": extension.seo|default([]),
            "content": content|default([]),
            "localizations": localizations|default([]),
            "shadowBaseLocale": shadowBaseLocale|default(),
        } %}
    {% endblock %}

    {% block style %}{% endblock %}
</head>
<body style="margin: 0px; padding: 0px">
    <header style="border-bottom: 1px solid silver">
        {% block header %}
            <nav style="display: flex; align-items: center; justify-content: space-between">
                <ul>
                    <li>
                        <a href="{{ sulu_content_root_path() }}">Homepage</a>
                    </li>

                    {% for item in sulu_page_navigation_root_tree('main') %}
                        <li>
                            <a href="{{ sulu_content_path(item.url) }}"
                               title="{{ item.title }}">{{ item.title }}</a>
                        </li>
                    {% endfor %}
                </ul>

                <div style="display: flex">
                    {% for localization in localizations|default([]) %}
                        <span style="border-right: 1px solid silver; padding: .25rem .5rem">
                            <a href="{{ localization.url }}">{{ localization.locale }}</a>
                        </span>
                    {% endfor %}
                    <a href="https://docs.sulu.io/en/2.5/book/localization.html" target="_blank" style="padding: .25rem .5rem">
                        More languages?
                    </a>
                </div>

                <a href="{{ path('login_explainer') }}">
                    <button>Login</button>
                </a>
            </nav>

            <nav>
                <ul>
                    {% for segment in segments|default([]) %}
                        <li>
                            <a href="{{ segment.url }}">{{ segment.title }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        {% endblock %}
    </header>

    <form action="{{ path('sulu_search.website_search') }}" method="GET" style="padding: 1rem;">
        <input name="q" type="text" placeholder="Search"/>
        <input type="submit" value="Go"/>
    </form>

    <main id="content" vocab="http://schema.org/" typeof="Content" style="width: 80%; margin: auto;">
        {% block content %}{% endblock %}
    </main>

    <footer style="text-align: center">
        {% block footer %}
            <p>Copyright {{ 'now'|date('Y') }} SULU</p>
        {% endblock %}
    </footer>

    {% block javascripts %}{% endblock %}
</body>
</html>
